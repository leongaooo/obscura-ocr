{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObscuraOCR Sensitive Field Candidate",
  "type": "object",
  "required": ["id", "type", "pageId", "bbox", "confidence", "status"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string" },
    "category": { "type": "string" },
    "pageId": { "type": "string" },
    "bbox": { "type": "array", "minItems": 4, "items": { "type": "number" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "severity": { "enum": ["critical", "high", "medium", "low"] },
    "status": { "enum": ["detected", "planned", "confirmed", "redacted", "rejected", "needs_review"] },
    "source": { "type": "array", "items": { "type": "string" } },
    "recommendedAction": { "type": "string" }
  }
}
